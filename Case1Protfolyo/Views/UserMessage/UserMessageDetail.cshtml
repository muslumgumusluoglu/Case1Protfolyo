@model UserMessage

@{
    ViewData["Title"] = "Mesaj Detayı";
    Layout = "~/Views/AdminLayout/Layout.cshtml";
}

<form method="post" class="glass-card">
    <div class="form-group">
        <label class="form-label">Adı</label>
        <input type="text" class="form-input" asp-for="Name" required>
    </div>

    <div class="form-group">
        <label class="form-label">Eposta</label>
        <input type="text" asp-for="Email" class="form-input" required />
    </div>

    <div class="form-group">
        <label class="form-label">Mesaj İçeriği</label>
        
        <textarea asp-for="MessageBody" class="form-input" rows="5" required></textarea>
    </div>


    <div class="form-actions">
        <a href="/UserMessage/Index" class="btn btn-primary">Mesajlara Dön</a>
        
    </div>
</form>

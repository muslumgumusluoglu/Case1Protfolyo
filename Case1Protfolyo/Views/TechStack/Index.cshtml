@model List<TechStack>
@{
    ViewData["Title"] = "Teknolojiler";
    Layout = "~/Views/AdminLayout/Layout.cshtml";
}

<div class="glass-card">
    <table class="custom-table">
        <thead>
            <tr>
                <th>Adı</th>
                <th>İşlemler</th>
            </tr>
        </thead>
        <tbody>

            @foreach (var item in Model)
            {
                <tr>
                    <td>
                        @item.Name
                    </td>
                    <td>
                        <div class="action-btns">
                            <a href="/TechStack/UpdateTechStack/@item.Id" class="action-btn" title="Düzenle"><i class="fa-solid fa-pen"></i></a>

                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
    <div class="form-actions">
        <div class="form-control"><a href="/TechStack/CreatTechStack/" class="btn btn-primary">Yeni Teknoloji Ekle</a></div>
    </div>



</div>
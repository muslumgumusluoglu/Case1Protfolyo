@{
    Layout = null;

}

<!DOCTYPE html>
<html lang="tr">
    @await Component.InvokeAsync("_AdminLayoutHead")
<body>

    <!-- Sidebar -->
    @await Component.InvokeAsync("_AdminLayoutSidebar")

    <!-- Main Content -->
    <main>
        <div class="top-header">
            <div class="page-title">
                <h1>@ViewData["Title"]</h1>
            </div>
            <div>
                <a href="/Default/" class="btn btn-primary">
                    <i class="fa-solid fa-plus"></i> Siteyi Görüntüle
                </a>
            </div>
        </div>

        @RenderBody()

    </main>

    
</body>
</html>

@model ContactInfo
@{
    ViewData["Title"] = "İletişim Bilgileri";
    Layout = "~/Views/AdminLayout/Layout.cshtml";
}


@if (@ViewBag.Durum != null)
{
    <div class="alert-message alert-success">@ViewBag.Durum</div>
}


<form method="post" class="glass-card">
    <input type="hidden" asp-for="Id" />
    <div class="form-group">
        <label class="form-label">Email Adresi</label>
        <input type="text" class="form-input" asp-for="Email" required>
    </div>

    <div class="form-group">
        <label class="form-label">Adres</label>
        <input type="text" class="form-input" asp-for="Adress" required>
    </div>

    <div class="form-group">
        <label class="form-label">Linkedin Url</label>
        <input type="text" asp-for="LinkedinUrl" class="form-input" required />
    </div>

    <div class="form-group">
        <label class="form-label">GitHub Url</label>
        <input type="text" asp-for="GitHubUrl" class="form-input" required />
    </div>


    <div class="form-actions">
        <button type="submit" class="btn btn-primary">
            <i class="fa-solid fa-floppy-disk"></i> Kaydet
        </button>
    </div>
</form>


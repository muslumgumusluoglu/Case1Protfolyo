@model ProjectTechStack

@{
    ViewData["Title"] = "Creat";
    Layout = "~/Views/AdminLayout/Layout.cshtml";
}

<form method="post">

    <div class="form-group">
        <label> Proje</label>
        <select class="form-input" asp-for="ProjectId" asp-items="ViewBag.projects" required>
            <option value="">..:: Proje Seçiniz ::..</option>
        </select>
    </div>

    <div class="form-group">
        <label> Teknoloji</label>
        <select class="form-input" asp-for="TechStackId" asp-items="ViewBag.techStacks" required>
            <option value="">..:: Teknoloji Seçiniz ::..</option>
        </select>
    </div>

    <div class="form-actions">
        <button type="submit" class="btn btn-primary">
            <i class="fa-solid fa-floppy-disk"></i> Kaydet
        </button>
    </div>
</form>
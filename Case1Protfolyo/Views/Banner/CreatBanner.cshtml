@model Banner

@{
    ViewData["Title"] = "Banner Ekle";
    Layout = "~/Views/AdminLayout/Layout.cshtml";
}

<form method="post" class="glass-card">
    <div class="form-group">
        <label class="form-label">Mini Başlık</label>
        <input type="text" class="form-input" asp-for="MiniTitle" required>
    </div>

    <div class="form-group">
        <label class="form-label">Başlık</label>
        <input type="text" class="form-input" asp-for="Title" required>
    </div>

    <div class="form-group">
        <label class="form-label">Açıklama</label>
        <textarea asp-for="Description" class="form-input" rows="5" required></textarea>
    </div>


    <div class="form-group">
        <label class="form-label">Url 1</label>
        <input type="text" class="form-input" asp-for="LinkUrl1">
    </div>

    <div class="form-group">
        <label class="form-label">Url 1 Text</label>
        <input type="text" class="form-input" asp-for="LinkUrl1Text">
    </div>

    <div class="form-group">
        <label class="form-label">Url 2</label>
        <input type="text" class="form-input" asp-for="LinkUrl2">
    </div>

    <div class="form-group">
        <label class="form-label">Url 1 Text</label>
        <input type="text" class="form-input" asp-for="LinkUrl2Text">
    </div>

  
    <div class="form-actions">
        <button type="submit" class="btn btn-primary">
            <i class="fa-solid fa-floppy-disk"></i> Kaydet
        </button>
    </div>
</form>

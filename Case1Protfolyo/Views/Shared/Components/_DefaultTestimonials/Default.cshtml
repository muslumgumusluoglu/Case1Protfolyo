
@{
    Layout = null;
}

<section>
    <div class="container">
        <div class="section-header">
            <span class="section-tag">DEĞERLENDİRMELER</span>
            <h2 class="section-title">Hakkımda Söylenenler</h2>
            <p class="section-subtitle">Birlikte çalıştığımız yöneticiler ve ekip arkadaşlarımın görüşleri.</p>
        </div>

        <div class="testimonials-grid">
            @foreach (var item in Model)
            {
                <div class="glass-card">
                    <div class="stars">
                        @for (int i = 0; i < item.Rating; i++)
                        {
                            <i class="fa-solid fa-star"></i>
                        }
                       
                    </div>
                    <p class="testimonial-text">"@item.Comment"</p>
                    <div class="client-info">
                        <div class="avatar">@item.Initials</div>
                        <div class="client-details">
                            <h5>@item.FirstName @item.LastName</h5>
                            <p>@item.Title</p>
                        </div>
                    </div>
                </div>
            }
            

            
        </div>
    </div>
</section>
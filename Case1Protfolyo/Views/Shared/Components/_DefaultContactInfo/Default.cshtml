@model ContactInfo

@{
    Layout = null;
}

<div>
    <span class="section-tag">İLETİŞİM</span>
    <h2 class="section-title">Birlikte Harika Projeler Geliştirelim</h2>
    <p style="color: var(--text-muted); font-size: 16px;">
        Yeni projeler, iş birlikleri ve freelance çalışmalar için benimle iletişime geçebilirsiniz. İhtiyaçlarınızı birlikte değerlendirelim ve size en uygun çözümü oluşturalım.
    </p>

    <div class="contact-info-list">
        <div class="contact-item">
            <div class="contact-icon">
                <i class="fa-regular fa-envelope"></i>
            </div>
            <div class="contact-details">
                <h5>Eposta</h5>
                <a href="mailto:@Model.Email">@Model.Email</a>
            </div>
        </div>

        <div class="contact-item">
            <div class="contact-icon">
                <i class="fa-solid fa-location-dot"></i>
            </div>
            <div class="contact-details">
                <h5>Adres</h5>
                <p>@Model.Adress
                </p>
            </div>
        </div>

        <div class="contact-item">
            <div class="contact-icon">
                <i class="fa-solid fa-share-nodes"></i>
            </div>
            <div class="contact-details">
                <h5>Sosyal Medya</h5>
                <div class="social-links">
                    <a href="@Model.LinkedinUrl" target="_blank" class="social-link">Linkedin Url</a> •
                    <a href="@Model.GitHubUrl" target="_blank" class="social-link">GitHub Url</a> •
                </div>
            </div>
        </div>
    </div>
</div>

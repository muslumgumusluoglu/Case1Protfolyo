@model List<Service>
@{
    Layout = null;
}

<section id="services">
    <div class="container">
        <div class="section-header">
            <span class="section-tag">UZMANLIKLARIM</span>
            <h2 class="section-title">Yazılım Çözümlerim</h2>
            <p class="section-subtitle">Performans, güvenlik ve kullanıcı deneyimini ön planda tutan yazılım hizmetleri.</p>
        </div>

        <div class="services-grid">
            
            @foreach (var item in Model)
            {
                <div class="glass-card">
                    <div class="service-icon">
                        <i class="fa-solid fa-code"></i>
                    </div>
                    <h3 class="service-title">@item.Title</h3>
                    <p style="color: var(--text-muted); font-size: 14px;">
                        @item.Description
                    </p>
                </div>
            }
            

            
        </div>
    </div>
</section>
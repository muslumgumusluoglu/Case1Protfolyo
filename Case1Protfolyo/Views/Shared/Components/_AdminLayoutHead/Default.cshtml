@*
    Admin Layout head partial view'i 
*@

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ALEX.DEV - Yönetim Paneli</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <style>
        :root {
            --bg-dark: #090a0f;
            --bg-sidebar: #0d1017;
            --bg-card: rgba(18, 22, 33, 0.7);
            --bg-input: rgba(255, 255, 255, 0.03);
            --accent-purple: #7928ca;
            --accent-blue: #0070f3;
            --accent-cyan: #00dfd8;
            --accent-gradient: linear-gradient(135deg, #7928ca 0%, #0070f3 50%, #00dfd8 100%);
            --text-main: #f3f4f6;
            --text-muted: #9ca3af;
            --border-color: rgba(255, 255, 255, 0.08);
            --border-hover: rgba(121, 40, 202, 0.4);
            --glow: 0 0 25px rgba(121, 40, 202, 0.2);
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Plus Jakarta Sans', sans-serif;
        }

        body {
            background-color: var(--bg-dark);
            color: var(--text-main);
            display: flex;
            min-height: 100vh;
            overflow-x: hidden;
            background-image: radial-gradient(circle at 10% 20%, rgba(121, 40, 202, 0.08) 0%, transparent 40%), radial-gradient(circle at 90% 80%, rgba(0, 112, 243, 0.08) 0%, transparent 40%);
            background-attachment: fixed;
        }

        /* Sidebar */
        aside {
            width: 260px;
            background: var(--bg-sidebar);
            border-right: 1px solid var(--border-color);
            display: flex;
            flex-direction: column;
            position: fixed;
            top: 0;
            bottom: 0;
            left: 0;
            z-index: 100;
        }

        .sidebar-header {
            padding: 24px;
            border-bottom: 1px solid var(--border-color);
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .logo {
            font-size: 20px;
            font-weight: 800;
            color: #fff;
            text-decoration: none;
        }

            .logo span {
                background: var(--accent-gradient);
                -webkit-background-clip: text;
                -webkit-text-fill-color: transparent;
            }

        .sidebar-menu {
            padding: 20px 16px;
            list-style: none;
            display: flex;
            flex-direction: column;
            gap: 6px;
            flex-grow: 1;
        }

        .menu-title {
            font-size: 11px;
            font-weight: 700;
            color: var(--text-muted);
            text-transform: uppercase;
            letter-spacing: 1.5px;
            margin: 16px 12px 8px 12px;
        }

        .menu-item a {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 12px 16px;
            color: var(--text-muted);
            text-decoration: none;
            font-size: 14px;
            font-weight: 500;
            border-radius: 12px;
            transition: all 0.3s ease;
        }

            .menu-item a:hover, .menu-item.active a {
                color: #fff;
                background: rgba(121, 40, 202, 0.15);
                border: 1px solid rgba(121, 40, 202, 0.3);
            }

        .menu-item.active a {
            box-shadow: var(--glow);
        }

        .menu-item i {
            font-size: 16px;
            width: 20px;
            text-align: center;
            color: var(--accent-cyan);
        }

        .sidebar-footer {
            padding: 20px;
            border-top: 1px solid var(--border-color);
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .user-avatar {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            background: var(--accent-gradient);
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 700;
            font-size: 14px;
        }

        .user-info h5 {
            font-size: 14px;
            font-weight: 700;
        }

        .user-info p {
            font-size: 12px;
            color: var(--text-muted);
        }

        /* Main Content */
        main {
            margin-left: 260px;
            flex-grow: 1;
            padding: 32px 40px;
            min-height: 100vh;
        }

        .top-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 32px;
        }

        .page-title h1 {
            font-size: 28px;
            font-weight: 800;
            letter-spacing: -0.5px;
        }

        .page-title p {
            font-size: 14px;
            color: var(--text-muted);
        }

        .glass-card {
            background: var(--bg-card);
            border: 1px solid var(--border-color);
            border-radius: 20px;
            padding: 32px;
            backdrop-filter: blur(12px);
        }

        /* Form Grid Layout */
        .form-grid {
            display: grid;
            grid-template-columns: 2fr 1fr;
            gap: 32px;
        }

        .form-group {
            margin-bottom: 24px;
        }

        .form-label {
            display: block;
            font-size: 13px;
            font-weight: 600;
            margin-bottom: 8px;
            color: var(--text-muted);
        }

        .form-input, .form-select, .form-textarea {
            width: 100%;
            padding: 12px 16px;
            border-radius: 12px;
            background: var(--bg-input);
            border: 1px solid var(--border-color);
            color: #fff;
            font-size: 14px;
            outline: none;
            transition: all 0.3s;
        }

            .form-input:focus, .form-select:focus, .form-textarea:focus {
                border-color: var(--accent-blue);
                box-shadow: 0 0 15px rgba(0, 112, 243, 0.2);
            }

        .form-textarea {
            resize: vertical;
            min-height: 140px;
        }

        /* Image Upload Box */
        .upload-box {
            border: 2px dashed var(--border-color);
            border-radius: 16px;
            padding: 32px;
            text-align: center;
            cursor: pointer;
            transition: all 0.3s;
            background: rgba(255, 255, 255, 0.01);
        }

            .upload-box:hover {
                border-color: var(--accent-purple);
                background: rgba(121, 40, 202, 0.05);
            }

        .upload-icon {
            font-size: 36px;
            color: var(--accent-cyan);
            margin-bottom: 12px;
        }

        .upload-text {
            font-size: 13px;
            color: var(--text-muted);
        }

            .upload-text span {
                color: #fff;
                font-weight: 600;
            }

        /* Action Buttons */
        .form-actions {
            display: flex;
            gap: 16px;
            justify-content: flex-end;
            margin-top: 24px;
            padding-top: 24px;
            border-top: 1px solid var(--border-color);
        }

        .btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            padding: 12px 28px;
            border-radius: 50px;
            font-weight: 600;
            font-size: 14px;
            text-decoration: none;
            transition: all 0.3s ease;
            cursor: pointer;
            border: none;
        }

        .btn-primary {
            background: var(--accent-gradient);
            color: #fff;
            box-shadow: var(--glow);
        }

            .btn-primary:hover {
                transform: translateY(-2px);
                box-shadow: 0 0 30px rgba(121, 40, 202, 0.4);
            }

        .btn-secondary {
            background: rgba(255, 255, 255, 0.05);
            color: var(--text-muted);
            border: 1px solid var(--border-color);
        }

            .btn-secondary:hover {
                color: #fff;
                background: rgba(255, 255, 255, 0.1);
            }

        /* Custom Table */
        .custom-table {
            width: 100%;
            border-collapse: collapse;
        }

            .custom-table th {
                text-align: left;
                padding: 14px 18px;
                font-size: 12px;
                font-weight: 700;
                color: var(--text-muted);
                text-transform: uppercase;
                border-bottom: 1px solid var(--border-color);
            }

            .custom-table td {
                padding: 18px;
                font-size: 14px;
                border-bottom: 1px solid var(--border-color);
                vertical-align: middle;
            }

            .custom-table tr:hover {
                background: rgba(255, 255, 255, 0.02);
            }

        .action-btns {
            display: flex;
            gap: 8px;
        }

        .action-btn {
            width: 34px;
            height: 34px;
            border-radius: 8px;
            background: rgba(255, 255, 255, 0.05);
            border: 1px solid var(--border-color);
            color: var(--text-muted);
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: all 0.2s;
            text-decoration: none;
        }

            .action-btn:hover {
                color: #fff;
                border-color: var(--accent-blue);
                background: rgba(0, 112, 243, 0.2);
            }

            .action-btn.delete:hover {
                border-color: #ef4444;
                background: rgba(239, 68, 68, 0.2);
                color: #f87171;
            }

        .badge {
            padding: 5px 12px;
            border-radius: 20px;
            font-size: 11px;
            font-weight: 600;
            display: inline-block;
        }

        .badge-success {
            background: rgba(34, 197, 94, 0.15);
            color: #4ade80;
            border: 1px solid rgba(34, 197, 94, 0.3);
        }

        .badge-warning {
            background: rgba(245, 158, 11, 0.15);
            color: #fbbf24;
            border: 1px solid rgba(245, 158, 11, 0.3);
        }

        .alert-message {
            display: flex;
            align-items: center;
            gap: 14px;
            padding: 16px 20px;
            margin-bottom: 25px;
            border-radius: 14px;
            border: 1px solid;
            backdrop-filter: blur(10px);
            animation: fadeIn .4s ease;
        }

            .alert-message i {
                font-size: 22px;
            }

            .alert-message span {
                font-size: 14px;
                font-weight: 500;
            }

        /* Başarılı */
        .alert-success {
            background: rgba(34, 197, 94, 0.12);
            border-color: rgba(34, 197, 94, 0.35);
            color: #4ade80;
            box-shadow: 0 0 20px rgba(34,197,94,.15);
        }

        /* Hata */
        .alert-danger {
            background: rgba(239, 68, 68, 0.12);
            border-color: rgba(239, 68, 68, 0.35);
            color: #f87171;
            box-shadow: 0 0 20px rgba(239,68,68,.15);
        }

        /* Uyarı */
        .alert-warning {
            background: rgba(245, 158, 11, 0.12);
            border-color: rgba(245, 158, 11, 0.35);
            color: #fbbf24;
            box-shadow: 0 0 20px rgba(245,158,11,.15);
        }

        
    </style>
</head>
@model List<Project>
@{
    Layout = null;
}

<section id="portfolio" style="background: rgba(15, 20, 30, 0.4);">
    <div class="container">
        <div class="section-header">
            <span class="section-tag">PORTFOLYO</span>
            <h2 class="section-title">Selected Work</h2>
            <p class="section-subtitle">A collection of my recent projects.</p>
        </div>

        <div class="portfolio-grid">

            


            @foreach (var item in Model)
            {
                <div class="glass-card portfolio-card">
                    <div class="portfolio-img-box">
                        <img src="@item.ImageUrl" alt="@item.Name" class="portfolio-img">
                    </div>
                    <div class="portfolio-body">
                        <h3 class="portfolio-title">@item.Name</h3>
                        <p class="portfolio-desc">@item.Description</p>
                        <div class="portfolio-tags">
                            @foreach (var tech in item.ProjectTechStacks)
                            {
                                <span class="portfolio-tag">@tech.TechStack.Name</span>
                            }
                        </div>
                    </div>
                </div>
            }
            

        </div>
    </div>
</section>
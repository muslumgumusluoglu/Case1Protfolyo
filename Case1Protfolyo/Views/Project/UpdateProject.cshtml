@model Project

@{
    ViewData["Title"] = "Proje Güncelleme";
    Layout = "~/Views/AdminLayout/Layout.cshtml";
}

<form method="post" class="glass-card">
    <input type="hidden" class="form-input" asp-for="Id" required>

    <div class="form-group">
        <label class="form-label">Başlık</label>
        <input type="text" class="form-input" asp-for="Name" required>
    </div>

    <div class="form-group">
        <label class="form-label">Açıklama</label>
        <textarea asp-for="Description" class="form-input" rows="5" required></textarea>
    </div>

    <div class="form-group">
        <label class="form-label">Görsel URL</label>
        <input type="text" asp-for="ImageUrl" class="form-input" required />
    </div>

    <div class="form-group">
        <label class="form-label">GitHub URL</label>
        <input type="text" asp-for="GitHuburl" class="form-input" required />
    </div>

    <div class="form-actions">
        <button type="submit" class="btn btn-primary">
            <i class="fa-solid fa-floppy-disk"></i> Güncelle
        </button>
    </div>
</form>


@model Project
@{
    ViewData["Title"] = "Proje OLuştur";
    Layout = "~/Views/AdminLayout/Layout.cshtml";
}


<form method="post" class="glass-card">
    <div class="form-group">
        <label class="form-label">Başlık</label>
        <input type="text" class="form-input" asp-for="Name" required>
        <span class="text-danger" asp-validation-for="Name"></span>
    </div>

    <div class="form-group">
        <label class="form-label">Açıklama</label>
        <textarea asp-for="Description" class="form-input" rows="5" required></textarea>
        <span class="text-danger" asp-validation-for="Description"></span>
    </div>

    <div class="form-group">
        <label class="form-label">Görsel URL</label>
        <input type="text" asp-for="ImageUrl" class="form-input" required />
        <span class="text-danger" asp-validation-for="ImageUrl"></span>
    </div>

    <div class="form-group">
        <label class="form-label">GitHub URL</label>
        <input type="text" asp-for="GitHuburl" class="form-input" />
        <span class="text-danger" asp-validation-for="GitHuburl"></span>
    </div>

    <div class="form-actions">
        <button type="submit" class="btn btn-primary">
            <i class="fa-solid fa-floppy-disk"></i> Kaydet
        </button>
    </div>
</form>
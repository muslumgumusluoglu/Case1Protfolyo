@model Experience
@{
    ViewData["Title"] = "Deneyim Ekle";
    Layout = "~/Views/AdminLayout/Layout.cshtml";
}

<form method="post" class="glass-card">
    <div class="form-group">
        <label class="form-label">Başlık</label>
        <input type="text" class="form-input" asp-for="Title" required>
    </div>

    <div class="form-group">
        <label class="form-label">Açıklama</label>
        <textarea asp-for="Description" class="form-input" rows="5" required></textarea>
    </div>

    <div class="form-group">
        <label class="form-label">Firma</label>
        <input type="text" asp-for="Company" class="form-input" required />
    </div>

    <div class="form-group">
        <label class="form-label">Başlama Yılı</label>
        <input type="text" asp-for="StartYear" class="form-input" required />
    </div>

    <div class="form-group">
        <label class="form-label">Bitme Yılı</label>
        <input type="text" asp-for="EndYear" class="form-input" required />
    </div>


    <div class="form-actions">
        <button type="submit" class="btn btn-primary">
            <i class="fa-solid fa-floppy-disk"></i> Kaydet
        </button>
    </div>
</form>

